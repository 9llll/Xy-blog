---
import { Icon } from "astro-icon/components";
import { navBarConfig, siteConfig } from "../config";
import { LinkPresets } from "../constants/link-presets";
import { LinkPreset, type NavBarLink } from "../types/config";
import { url } from "../utils/url-utils";
import LightDarkSwitch from "./LightDarkSwitch.svelte";
import Search from "./Search.svelte";
import DisplaySettings from "./widget/DisplaySettings.svelte";

const className = Astro.props.class;

let links: NavBarLink[] = navBarConfig.links.map(
	(item: NavBarLink | LinkPreset): NavBarLink => {
		if (typeof item === "number") {
			return LinkPresets[item];
		}
		return item;
	},
);
---
<!--
    导航栏为独立悬浮卡片：四边圆角 + 顶部留白，
    避免贴紧视口顶部导致上圆角被裁掉一半（视觉上像"圆角在下"）。
    mt 由外层 #top-row 控制，此处只负责卡片自身的圆角与边框。
-->
<div
    id="navbar"
    class="z-50 onload-animation mx-auto max-w-[var(--page-width)] bg-[var(--card-bg)]
           border border-[#19191914] rounded-[var(--radius-large)] shadow-sm"
>
    <div class:list={[
        className,
        "!overflow-visible h-[4.5rem] !rounded-t-none mx-auto flex items-center justify-between px-4 max-w-[var(--page-width)] relative"]}>
        <button aria-label="Menu" name="Nav Menu" class="btn-plain scale-animation rounded-lg w-11 h-11 active:scale-90 lg:!hidden" id="nav-menu-switch">
            <Icon name="material-symbols:menu-rounded" class="text-[1.25rem]"></Icon>
        </button>
        <a href={url('/')} class="btn-plain scale-animation rounded-lg h-[3.25rem] px-5 font-bold active:scale-95">
            <div class="flex flex-row items-center text-md text-black/85 dark:text-white/85">
                {/*
                    logo 在 src/data/site.json 的 logo 字段配置。
                    配了图片 → 只显示图片（横向 logo 通常已含站点名，再显示文字会重复）；
                    留空 → 回落内置图标 + 文字。
                */}
                {siteConfig.logo ? (
                    <img
                        src={siteConfig.logo}
                        alt={siteConfig.title}
                        width="131"
                        height="40"
                        decoding="async"
                        class="h-9 w-auto object-contain sm:h-10"
                    />
                ) : (
                    <>
                        <Icon name="material-symbols:home-outline-rounded" class="text-[1.75rem] mb-1 mr-2" />
                        {siteConfig.title}
                    </>
                )}
            </div>
        </a>
        <div class="hidden lg:flex absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 items-center">
            {links.map((l) => {
                const children = l.children ?? [];
                const hasChildren = children.length > 0;
                const isExternal = !!l.external;
                const triggerClass =
                    "btn-plain scale-animation rounded-lg h-11 font-bold px-5 active:scale-95 flex items-center gap-1";
                const caret = (
                    <Icon
                        name="material-symbols:keyboard-arrow-down-rounded"
                        class="nav-caret text-[1.05rem] text-black/30 dark:text-white/30 transition-transform duration-200"
                    />
                );

                // 无子项：普通链接
                if (!hasChildren) {
                    return <a aria-label={l.name} href={isExternal ? l.url : url(l.url)} target={isExternal ? "_blank" : null}
                              class={triggerClass}
                    >
                        <span>{l.name}</span>
                        {isExternal && <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.875rem] transition -translate-y-[1px] text-black/[0.2] dark:text-white/[0.2]"></Icon>}
                    </a>;
                }

                // 有子项：hover / 键盘聚焦展开二级面板；父项 url 留空时只作分组标题，仅展开不跳转
                return (
                    <div class="nav-dropdown group relative">
                        {l.url ? (
                            <a aria-label={l.name} href={isExternal ? l.url : url(l.url)} target={isExternal ? "_blank" : null}
                               class={triggerClass}
                            >
                                <span>{l.name}</span>
                                {caret}
                            </a>
                        ) : (
                            <button type="button" data-nav-trigger aria-haspopup="menu" aria-expanded="false" aria-label={l.name} class={triggerClass}>
                                <span>{l.name}</span>
                                {caret}
                            </button>
                        )}
                        <div class="nav-panel absolute left-1/2 top-full z-50 pt-2">
                            <div class="min-w-[11rem] overflow-hidden rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] p-1.5 shadow-[0_18px_44px_-18px_rgba(0,0,0,0.42)]">
                                {children.map((child) => (
                                    <a
                                        href={child.external ? child.url : url(child.url)}
                                        target={child.external ? "_blank" : null}
                                        class="flex items-center gap-2 rounded-lg px-3 py-2 text-[13px] font-medium text-black/70 dark:text-white/70
                                               transition-colors hover:bg-[var(--btn-regular-bg)] hover:text-[var(--primary)]"
                                    >
                                        <span class="flex-1 whitespace-nowrap">{child.name}</span>
                                        {child.external && (
                                            <Icon name="fa6-solid:arrow-up-right-from-square" class="text-[0.65rem] text-black/25 dark:text-white/25" />
                                        )}
                                    </a>
                                ))}
                            </div>
                        </div>
                    </div>
                );
            })}
        </div>
        <div class="flex">
            <!--<SearchPanel client:load>-->
            <Search client:only="svelte"></Search>
            <LightDarkSwitch client:only="svelte"></LightDarkSwitch>
        </div>

        <DisplaySettings client:only="svelte"></DisplaySettings>
    </div>
</div>

<style>
    /* 二级导航面板：默认收起；悬停、键盘聚焦、点击三种方式都能展开 */
    .nav-panel {
        visibility: hidden;
        opacity: 0;
        transform: translate(-50%, 6px);
        transition: opacity 0.15s ease, transform 0.15s ease, visibility 0.15s;
    }
    .nav-dropdown:hover .nav-panel,
    .nav-dropdown:focus-within .nav-panel,
    .nav-dropdown[data-open] .nav-panel {
        visibility: visible;
        opacity: 1;
        transform: translate(-50%, 0);
    }
    .nav-dropdown:hover .nav-caret,
    .nav-dropdown:focus-within .nav-caret,
    .nav-dropdown[data-open] .nav-caret {
        transform: rotate(180deg);
    }
</style>

<script>
function switchTheme() {
    if (localStorage.theme === 'dark') {
        document.documentElement.classList.remove('dark');
        localStorage.theme = 'light';
    } else {
        document.documentElement.classList.add('dark');
        localStorage.theme = 'dark';
    }
}

function loadButtonScript() {
    let switchBtn = document.getElementById("scheme-switch");
    if (switchBtn) {
        switchBtn.onclick = function () {
            switchTheme()
        };
    }

    let settingBtn = document.getElementById("display-settings-switch");
    if (settingBtn) {
        settingBtn.onclick = function () {
            let settingPanel = document.getElementById("display-setting");
            if (settingPanel) {
                settingPanel.classList.toggle("float-panel-closed");
            }
        };
    }

    let menuBtn = document.getElementById("nav-menu-switch");
    if (menuBtn) {
        menuBtn.onclick = function () {
            // 调用侧边栏的打开函数
            if (window.openNavMenu) {
                window.openNavMenu();
            }
        };
    }
}

loadButtonScript();

/**
 * 二级导航的点击与键盘行为
 * 悬停和聚焦由 CSS 处理；这里补两件事：
 * 1) 触屏设备上点击父项可展开/收起（触屏没有 hover）
 * 2) 点击外部或按 Esc 收起
 */
function setupNavDropdowns() {
    const closeAll = (except) => {
        document.querySelectorAll("#navbar .nav-dropdown[data-open]").forEach((wrap) => {
            if (wrap === except) return;
            wrap.removeAttribute("data-open");
            wrap.querySelector("[data-nav-trigger]")?.setAttribute("aria-expanded", "false");
        });
    };

    document.addEventListener("click", (event) => {
        const trigger = event.target.closest("#navbar [data-nav-trigger]");
        if (!trigger) {
            closeAll(null);
            return;
        }
        const wrap = trigger.closest(".nav-dropdown");
        const willOpen = !wrap.hasAttribute("data-open");
        closeAll(wrap);
        if (willOpen) {
            wrap.setAttribute("data-open", "");
            trigger.setAttribute("aria-expanded", "true");
        } else {
            wrap.removeAttribute("data-open");
            trigger.setAttribute("aria-expanded", "false");
        }
    });

    document.addEventListener("keydown", (event) => {
        if (event.key === "Escape") closeAll(null);
    });
}

setupNavDropdowns();

</script>

{import.meta.env.PROD && <script is:inline define:vars={{scriptUrl: url('/pagefind/pagefind.js')}}>
async function loadPagefind() {
    try {
        const response = await fetch(scriptUrl, { method: 'HEAD' });
        if (!response.ok) {
            throw new Error(`Pagefind script not found: ${response.status}`);
        }

        const pagefind = await import(scriptUrl);

        await pagefind.options({
            excerptLength: 20
        });

        window.pagefind = pagefind;

        document.dispatchEvent(new CustomEvent('pagefindready'));
        console.log('Pagefind loaded and initialized successfully, event dispatched.');
    } catch (error) {
        console.error('Failed to load Pagefind:', error);
        window.pagefind = {
            search: () => Promise.resolve({ results: [] }),
            options: () => Promise.resolve(),
        };
        document.dispatchEvent(new CustomEvent('pagefindloaderror'));
        console.log('Pagefind load error, event dispatched.');
    }
}

if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', loadPagefind);
} else {
    loadPagefind();
}
</script>}