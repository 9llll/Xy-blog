---
import I18nKey from "../../i18n/i18nKey";
import { i18n } from "../../i18n/translation";
import { type CategoryNode, getCategoryTree } from "../../utils/content-utils";
import ButtonLink from "../control/ButtonLink.astro";
import WidgetLayout from "./WidgetLayout.astro";

/**
 * 分类卡片（旧版侧栏仍在用）
 * 与首页 BoardNav 共用同一棵分类树：`游戏资源/动作冒险` 会缩进显示在父级下面。
 */
const categoryTree = await getCategoryTree();

const COLLAPSED_HEIGHT = "7.5rem";
const COLLAPSE_THRESHOLD = 5;

type Row = { node: CategoryNode; depth: number };
const rows: Row[] = [];
const collect = (nodes: CategoryNode[], depth: number) => {
	nodes.forEach((node) => {
		rows.push({ node, depth });
		collect(node.children, depth + 1);
	});
};
collect(categoryTree, 0);

const isCollapsed = rows.length >= COLLAPSE_THRESHOLD;

interface Props {
	class?: string;
	style?: string;
}
const className = Astro.props.class;
const style = Astro.props.style;
---

<WidgetLayout name={i18n(I18nKey.categories)} id="categories" isCollapsed={isCollapsed} collapsedHeight={COLLAPSED_HEIGHT}
                class={className} style={style}
>
    {rows.map(({ node, depth }) =>
        <ButtonLink
            url={node.url}
            badge={String(node.count)}
            label={`View all posts in the ${node.fullName} category`}
        >
            <span
                class:list={["inline-block", depth > 0 ? "text-[0.92em] opacity-80" : ""]}
                style={depth > 0 ? `padding-left:${depth * 14}px` : undefined}
                title={node.fullName}
            >{node.name}</span>
        </ButtonLink>
    )}
</WidgetLayout>
