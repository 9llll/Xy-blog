---
// 代码块字体（Maple Mono CN）不在组件里 import：那是 239 条 @font-face，
// 而文章页是 catch-all 路由，Astro 会把它的 CSS 注入所有页面（首页白下 250 KB）。
// 改为 public 静态文件 + 文章页 <link>，见 src/pages/[...slug].astro 的 head slot。
// KaTeX 同理：只有正文可能有公式，样式随本组件按页面加载
import "katex/dist/katex.css";

interface Props {
	class: string;
}
const className = Astro.props.class;
---
<div data-pagefind-body class={`prose dark:prose-invert prose-base !max-w-none custom-md ${className}`}>
    <!--<div class="prose dark:prose-invert max-w-none custom-md">-->
    <!--<div class="max-w-none custom-md">-->
    <slot/>
</div>

<script>
document.addEventListener("click", function (e: MouseEvent) {
    const target = e.target as Element | null;
    if (target && target.classList.contains("copy-btn")) {
        const preEle = target.closest("pre");
        const codeEle = preEle?.querySelector("code");
        const code = Array.from(codeEle?.querySelectorAll(".code:not(summary *)") ?? [])
            .map(el => el.textContent)
            .map(t => t === "\n" ? "" : t)
            .join("\n");
        navigator.clipboard.writeText(code);

        const timeoutId = target.getAttribute("data-timeout-id");
        if (timeoutId) {
            clearTimeout(parseInt(timeoutId));
        }

        target.classList.add("success");

        // 设置新的timeout并保存ID到按钮的自定义属性中
        const newTimeoutId = setTimeout(() => {
            target.classList.remove("success");
        }, 1000);

        target.setAttribute("data-timeout-id", newTimeoutId.toString());
    }
});

// 视频点击播放面板：点击封面后才注入真正的播放器并自动播放
document.addEventListener("click", function (e: MouseEvent) {
    const btn = (e.target as Element | null)?.closest("[data-video-facade-play]");
    if (!btn) return;
    const facade = btn.closest(".video-facade") as HTMLElement | null;
    if (!facade || facade.dataset.playing === "1") return;

    const src = facade.dataset.embedSrc ?? "";
    const type = facade.dataset.embedType ?? "iframe";
    const poster = facade.dataset.poster ?? "";

    if (type === "video") {
        const v = document.createElement("video");
        v.src = src;
        v.controls = true;
        v.autoplay = true;
        v.playsInline = true;
        if (poster) v.poster = poster;
        v.className = "absolute inset-0 h-full w-full bg-black";
        facade.innerHTML = "";
        facade.appendChild(v);
        v.play?.().catch(() => {});
    } else {
        let finalSrc = src;
        try {
            const u = new URL(src);
            if (!u.searchParams.has("autoplay")) u.searchParams.set("autoplay", "1");
            if (!u.searchParams.has("danmaku")) u.searchParams.set("danmaku", "0");
            if (!u.searchParams.has("high_quality")) u.searchParams.set("high_quality", "1");
            finalSrc = u.toString();
        } catch {
            // 相对地址直接使用
        }
        const f = document.createElement("iframe");
        f.src = finalSrc;
        f.className = "absolute inset-0 h-full w-full";
        f.setAttribute("frameborder", "0");
        f.setAttribute("allowfullscreen", "");
        f.setAttribute(
            "allow",
            "autoplay; encrypted-media; clipboard-write; gyroscope; picture-in-picture; web-share",
        );
        facade.innerHTML = "";
        facade.appendChild(f);
    }
    facade.dataset.playing = "1";
});

// 标记了 data-autoplay 的面板：加载后自动触发一次点击
document.addEventListener("DOMContentLoaded", function () {
    document.querySelectorAll(".video-facade[data-autoplay]").forEach((el) => {
        (el.querySelector("[data-video-facade-play]") as HTMLElement | null)?.click();
    });
});
</script>

<!-- 图片灯箱：只在有正文/封面的页面需要（原先挂在 Layout，首页白下 17 KB JS + CSS） -->
<script>
import PhotoSwipeLightbox from "photoswipe/lightbox"
import "photoswipe/style.css"

let lightbox: PhotoSwipeLightbox
let pswp = import("photoswipe")

function createPhotoSwipe() {
	lightbox = new PhotoSwipeLightbox({
		gallery: ".custom-md img, #post-cover img",
		pswpModule: () => pswp,
		closeSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M480-424 284-228q-11 11-28 11t-28-11q-11-11-11-28t11-28l196-196-196-196q-11-11-11-28t11-28q11-11 28-11t28 11l196 196 196-196q11-11 28-11t28 11q11 11 11 28t-11 28L536-480l196 196q11 11 11 28t-11 28q-11 11-28 11t-28-11L480-424Z"/></svg>',
		zoomSVG: '<svg xmlns="http://www.w3.org/2000/svg" height="24px" viewBox="0 -960 960 960" width="24px" fill="#ffffff"><path d="M340-540h-40q-17 0-28.5-11.5T260-580q0-17 11.5-28.5T300-620h40v-40q0-17 11.5-28.5T380-700q17 0 28.5 11.5T420-660v40h40q17 0 28.5 11.5T500-580q0 17-11.5 28.5T460-540h-40v40q0 17-11.5 28.5T380-460q-17 0-28.5-11.5T340-500v-40Zm40 220q-109 0-184.5-75.5T120-580q0-109 75.5-184.5T380-840q109 0 184.5 75.5T640-580q0 44-14 83t-38 69l224 224q11 11 11 28t-11 28q-11 11-28 11t-28-11L532-372q-30 24-69 38t-83 14Zm0-80q75 0 127.5-52.5T560-580q0-75-52.5-127.5T380-760q-75 0-127.5 52.5T200-580q0 75 52.5 127.5T380-400Z"/></svg>',
		padding: { top: 20, bottom: 20, left: 20, right: 20 },
		wheelToZoom: true,
		arrowPrev: false,
		arrowNext: false,
		imageClickAction: 'close',
		tapAction: 'close',
		doubleTapAction: 'zoom',
	})

	lightbox.addFilter("domItemData", (itemData, element) => {
		if (element instanceof HTMLImageElement) {
			itemData.src = element.src

			itemData.w = Number(element.naturalWidth || window.innerWidth)
			itemData.h = Number(element.naturalHeight || window.innerHeight)

			itemData.msrc = element.src
		}

		return itemData
	})

	lightbox.init()
}

// 初始化 PhotoSwipe
createPhotoSwipe()
</script>
