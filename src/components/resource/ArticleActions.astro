---
import { Icon } from "astro-icon/components";

/**
 * 文章页的轻交互：阅读进度条 + 文末分享
 *
 * 两样都不联网、不引第三方 SDK、不加额外请求：
 *   - 进度条读 scrollHeight 算百分比，滚动事件 passive 监听
 *   - 分享走 navigator.share（手机原生面板）与几个分享链接，
 *     剪贴板不可用时退回 execCommand，与下载卡的复制逻辑一致
 *
 * 刻意不做二维码：要么引二维码库（增加体积），要么走第三方图片接口
 * （泄露访问来源、且被墙就白块），都不划算。
 */
interface Props {
	title: string;
}

const { title } = Astro.props;

const btn =
	"inline-flex items-center gap-1.5 rounded-md px-3 py-1.5 text-[12.5px] font-medium transition-colors " +
	"bg-[var(--btn-regular-bg)] text-black/70 hover:bg-[var(--btn-regular-bg-hover)] hover:text-[var(--primary)] " +
	"dark:text-white/70";
---

<div
	id="reading-progress"
	aria-hidden="true"
	class="fixed left-0 top-0 z-[60] h-[3px] w-0 bg-[var(--primary)] transition-[width] duration-75 ease-out"
>
</div>

<section class="mt-4 rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] px-4 py-3 shadow-sm">
	<div class="flex flex-wrap items-center gap-2">
		<span class="mr-1 inline-flex items-center gap-1.5 text-[12.5px] text-black/45 dark:text-white/45">
			<Icon name="material-symbols:share-outline" class="text-[1rem]" />
			分享这篇
		</span>

		<button type="button" data-share="copy" class={btn} aria-label="复制本文链接">
			<Icon name="material-symbols:link-rounded" class="text-[0.95rem]" />
			<span data-share-text>复制链接</span>
		</button>

		<button type="button" data-share="native" class={`${btn} hidden`} aria-label="调用系统分享">
			<Icon name="material-symbols:ios-share-rounded" class="text-[0.95rem]" />
			系统分享
		</button>

		<a
			data-share="weibo"
			href={`https://service.weibo.com/share/share.php?url=${encodeURIComponent(Astro.url.href)}&title=${encodeURIComponent(title)}`}
			target="_blank"
			rel="noopener noreferrer nofollow"
			class={btn}
			aria-label="分享到微博"
		>
			<Icon name="fa6-brands:weibo" class="text-[0.9rem]" />
			微博
		</a>

		<a
			data-share="telegram"
			href={`https://t.me/share/url?url=${encodeURIComponent(Astro.url.href)}&text=${encodeURIComponent(title)}`}
			target="_blank"
			rel="noopener noreferrer nofollow"
			class={btn}
			aria-label="分享到 Telegram"
		>
			<Icon name="fa6-brands:telegram" class="text-[0.9rem]" />
			Telegram
		</a>
	</div>
</section>

<script>
	// 阅读进度条
	const bar = document.getElementById("reading-progress");
	if (bar) {
		const update = () => {
			const root = document.documentElement;
			const max = root.scrollHeight - root.clientHeight;
			const percent = max > 0 ? (root.scrollTop / max) * 100 : 0;
			bar.style.width = `${Math.min(100, Math.max(0, percent))}%`;
		};
		window.addEventListener("scroll", update, { passive: true });
		window.addEventListener("resize", update);
		update();
	}

	// 复制链接
	const copyBtn = document.querySelector<HTMLButtonElement>('[data-share="copy"]');
	copyBtn?.addEventListener("click", async () => {
		const url = window.location.href;
		let done = false;
		try {
			await navigator.clipboard.writeText(url);
			done = true;
		} catch {
			// 非安全上下文下的兜底，与下载卡复制逻辑一致
			const ta = document.createElement("textarea");
			ta.value = url;
			ta.style.position = "fixed";
			ta.style.opacity = "0";
			document.body.appendChild(ta);
			ta.select();
			document.execCommand("copy");
			ta.remove();
			done = true;
		}
		if (!done) return;

		const label = copyBtn.querySelector<HTMLElement>("[data-share-text]");
		if (!label) return;
		const original = label.textContent ?? "复制链接";
		label.textContent = "已复制";
		setTimeout(() => {
			label.textContent = original;
		}, 1600);
	});

	// 系统分享：只在支持的环境显示（主要是手机与 Safari）
	const nativeBtn = document.querySelector<HTMLButtonElement>('[data-share="native"]');
	if (nativeBtn && typeof navigator.share === "function") {
		nativeBtn.classList.remove("hidden");
		nativeBtn.addEventListener("click", async () => {
			try {
				await navigator.share({ title: document.title, url: window.location.href });
			} catch {
				// 用户取消，无需提示
			}
		});
	}
</script>
