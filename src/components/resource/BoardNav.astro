---
import { Icon } from "astro-icon/components";
import { type CategoryNode, getCategoryTree } from "../../utils/content-utils";

/**
 * 首页左侧「板块导航」
 * 用现有文章分类（category）渲染，点进去是该分类归档。
 *
 * 分类名支持「父/子」写法：`游戏资源/动作冒险` 会缩进显示在 `游戏资源` 下面，
 * 父级计数包含所有子级文章。只写一级的旧文章仍按一级展示。
 */
const categories = await getCategoryTree();

const PALETTE = [
	"#f59e0b",
	"#3b82f6",
	"#10b981",
	"#8b5cf6",
	"#ef4444",
	"#06b6d4",
	"#ec4899",
	"#84cc16",
];

type Row = { node: CategoryNode; depth: number; color: string };
const rows: Row[] = [];

/** 压平分类树：子级继承父级颜色，保证同一大类视觉成组 */
const collect = (nodes: CategoryNode[], depth: number, inherited?: string) => {
	nodes.forEach((node, i) => {
		const color = inherited ?? PALETTE[i % PALETTE.length];
		rows.push({ node, depth, color });
		collect(node.children, depth + 1, color);
	});
};
collect(categories, 0);
---

<div class="rounded-xl bg-[var(--card-bg)] border border-[var(--line-divider)] overflow-hidden shadow-sm">
    <div class="flex items-center gap-2 h-12 px-4 border-b border-[var(--line-divider)]">
        <Icon name="material-symbols:grid-view-rounded" class="text-[1.2rem] text-[var(--primary)]" />
        <span class="font-bold text-[15px] text-black/85 dark:text-white/85">资源分类</span>
    </div>
    <nav class="py-2">
        {rows.length === 0 && (
            <div class="px-4 py-6 text-center text-[13px] text-black/40 dark:text-white/40">暂无板块</div>
        )}
        {rows.map(({ node, depth, color }) => (
            <a
                href={node.url}
                title={node.fullName}
                aria-label={`查看「${node.fullName}」分类下的全部文章`}
                class:list={[
                    "group flex items-center gap-2.5 transition-colors hover:bg-[var(--btn-regular-bg)] hover:text-[var(--primary)]",
                    depth === 0
                        ? "text-[13.5px] text-black/70 dark:text-white/70"
                        : "text-[12.5px] text-black/55 dark:text-white/55",
                ]}
                style={`padding:${depth === 0 ? "10px" : "7px"} 16px ${depth === 0 ? "10px" : "7px"} ${16 + depth * 18}px`}
            >
                <span
                    class:list={[
                        "inline-block rounded-full shrink-0 transition-opacity",
                        depth === 0 ? "w-1.5 h-1.5" : "w-1 h-1 opacity-70 group-hover:opacity-100",
                    ]}
                    style={`background:${color}`}
                ></span>
                <span class:list={["flex-1 truncate", depth === 0 ? "font-medium" : ""]}>{node.name}</span>
                <span class="text-[11px] text-black/30 dark:text-white/30 group-hover:text-[var(--primary)]">{node.count}</span>
            </a>
        ))}
    </nav>
</div>
