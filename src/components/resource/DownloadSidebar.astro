---
import { Icon } from "astro-icon/components";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import type { DownloadListItem } from "../../utils/download-anchor";
import {
	dlCover,
	dlMiniBody,
	dlMiniBtn,
	dlMiniCard,
	dlMiniCode,
	dlMiniCoverTag,
	dlMiniCoverWrap,
	dlMiniFoot,
	dlMiniMeta,
	dlMiniTitle,
	dlMiniTop,
	dlNdDot,
	dlNdImg,
	dlTagFree,
	dlTagLock,
	dlTagPay,
} from "../../utils/download-styles";

/**
 * 文章页右侧栏「下载地址」卡
 *
 * 与正文里的 ::download 卡片是**同一个卡片**（同一套 download-styles 类名与视觉语言），
 * 但右栏不持有任何地址 / 密码哈希 / 提取码：
 * 点「下载」时通过 data-dl-target 把动作托给正文对应卡片，
 * 由那张卡片完成解密与跳转，效果与直接点正文卡完全一致
 * （免费资源直接下载，加密资源弹密码框）。
 * 所以密钥材料全站只有一份，也不会随 /api/articles.json 的 metadata 外泄。
 *
 * 交互脚本是全站唯一的 DownloadSupport（事件委托），本组件不需要额外 JS。
 */
interface Props {
	downloads: DownloadListItem[];
}

const { downloads } = Astro.props;

const TAG_TEXT: Record<string, string> = {
	free: "免费",
	lock: "加密",
	pay: "付费",
};

const TAG_CLASS: Record<string, string> = {
	free: dlTagFree,
	lock: dlTagLock,
	pay: dlTagPay,
};
---

<div class="dl-side overflow-hidden rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] shadow-sm">
    <div class="flex items-center gap-2 border-b border-[var(--line-divider)] px-3.5 py-2.5">
        <Icon name="material-symbols:download-for-offline-outline-rounded" class="text-[1.15rem] text-[var(--primary)]" />
        <span class="font-bold text-[13.5px] text-black/85 dark:text-white/85">下载地址</span>
        <span class="ml-auto rounded-full bg-[var(--btn-regular-bg)] px-1.5 py-0.5 text-[10.5px] font-semibold text-black/40 dark:text-white/40">
            {downloads.length}
        </span>
    </div>

    <ul class="space-y-2 p-2">
        {downloads.map((d) => (
            <li>
                <div class={dlMiniCard}>
                    <!-- 信息行：点击跳到正文卡片 -->
                    <a href={`#${d.key}`} class={dlMiniTop} title={d.name}>
                        <span class={dlMiniCoverWrap}>
                            <img class={dlCover} src={d.cover} alt="" loading="lazy" />
                            <span class:list={[dlMiniCoverTag, TAG_CLASS[d.kind]]}>
                                {d.tag || TAG_TEXT[d.kind]}
                            </span>
                        </span>
                        <span class={dlMiniBody}>
                            <span class={dlMiniTitle}>{d.name}</span>
                            <span class={dlMiniMeta}>
                                {d.netdisk?.kind === "img" && d.netdisk.src ? (
                                    <img class={dlNdImg} src={d.netdisk.src} alt="" loading="lazy" />
                                ) : d.netdisk?.label ? (
                                    <span class="inline-flex items-center gap-1 min-w-0">
                                        <span class={dlNdDot} style={`background:${d.netdisk.color || "var(--primary)"}`}></span>
                                        <span class="truncate">{d.netdisk.label}</span>
                                    </span>
                                ) : null}
                                {d.kind === "pay" && d.price && (
                                    <span class="font-semibold text-[#d97706] dark:text-[#fbbf24]">¥{d.price}</span>
                                )}
                                {d.size && <span class="shrink-0">{d.size}</span>}
                            </span>
                        </span>
                    </a>

                    <!-- 操作行：提取码 + 下载/购买 -->
                    <div class={dlMiniFoot}>
                        {d.hasCode ? (
                            <button
                                type="button"
                                class={dlMiniCode}
                                data-dl-copy-target={d.key}
                                data-dl-copied-label={i18n(I18nKey.downloadCodeCopied)}
                                title={i18n(I18nKey.downloadCode)}
                            >
                                <Icon name="material-symbols:key-rounded" class="shrink-0 text-[0.8rem]" />
                                <span class="truncate" data-dl-code-text>
                                    {i18n(I18nKey.downloadCode)}
                                </span>
                            </button>
                        ) : (
                            <span class="min-w-0 flex-1 truncate text-[0.65rem] text-black/40 dark:text-white/40">
                                {d.desc}
                            </span>
                        )}

                        {d.kind === "pay" && d.buy ? (
                            <a
                                href={d.buy}
                                target="_blank"
                                rel="noopener noreferrer"
                                class={dlMiniBtn}
                                data-dl-pay="1"
                            >
                                购买
                            </a>
                        ) : (
                            <button
                                type="button"
                                class={dlMiniBtn}
                                data-dl-target={d.key}
                                title={d.name}
                            >
                                <Icon name="material-symbols:download-rounded" class="text-[0.85rem]" />
                                {i18n(I18nKey.downloadAction)}
                            </button>
                        )}
                    </div>
                </div>
            </li>
        ))}
    </ul>

    <div class="border-t border-[var(--line-divider)] px-3.5 py-2 text-[10.5px] leading-relaxed text-black/35 dark:text-white/35">
        点「下载」即可获取；加密资源需输入密码。点名称可跳到正文卡片。
    </div>
</div>
