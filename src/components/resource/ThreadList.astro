---
import { Icon } from "astro-icon/components";
import { profileConfig } from "../../config";
import { getHomePosts, type HomePost } from "../../utils/home-posts";
import { formatDateToYYYYMMDD } from "../../utils/date-utils";
import { getPostUrlBySlug } from "../../utils/url-utils";
import { POST_KIND_META, getPostKind } from "../../utils/post-kind";
import { getCategoryLabel } from "../../utils/content-utils";
import PostPagination from "./PostPagination.astro";

interface Props {
	/** 当前页的文章；不传则取全部（兼容旧用法） */
	posts?: HomePost[];
	currentPage?: number;
	totalPages?: number;
	totalCount?: number;
	/** 列表面板标题。首页用默认「最新发布」，分类页传分类名 */
	heading?: string;
}

const {
	posts: pagePosts,
	currentPage = 1,
	totalPages = 1,
	totalCount,
	heading = "最新发布",
} = Astro.props;

/**
 * 首页中部「最新帖子」列表（论坛风格）
 * 数据来自现有文章集合，分类取 frontmatter.category[0]。
 * 分页由 index.astro / page/[...page].astro 在服务端切好页再传进来。
 * 标题前的徽章由正文自动判定：免费资源 / 加密资源 / 资讯博文 / 开源项目。
 */
const list = pagePosts ?? (await getHomePosts());
const total = totalCount ?? list.length;
const badgeBase = "shrink-0 rounded px-1.5 py-0.5 text-[10.5px] font-bold text-white leading-none";
/**
 * 分类徽章：弱化处理（浅蓝底 + 深蓝字）。
 * 分类在列表里几乎条条相同，信息价值低；如果和类型徽章都用实心高饱和色块，
 * 一条里上下两个彩色块会互相抢眼，整体看着花。类型徽章保留实心，分类降一档。
 */
const catBadge =
	"shrink-0 rounded px-1.5 py-0.5 text-[10.5px] font-semibold leading-none " +
	"bg-[#e0f2fe] text-[#0369a1] dark:bg-[#0b3a52] dark:text-[#7dd3fc]";
---
<div class="rounded-xl bg-[var(--card-bg)] border border-[var(--line-divider)] overflow-hidden shadow-sm">
    <div class="flex items-center gap-2 h-12 px-4 border-b border-[var(--line-divider)]">
        <Icon name="material-symbols:forum-outline-rounded" class="text-[1.2rem] text-[var(--primary)]" />
        <h1 class="font-bold text-[15px] text-black/85 dark:text-white/85">{heading}</h1>
        <span class="ml-auto text-[11.5px] text-black/30 dark:text-white/30">
            共 {total} 篇{totalPages > 1 ? ` · 第 ${currentPage}/${totalPages} 页` : ""}
        </span>
    </div>

    <div class="divide-y divide-[var(--line-divider)]">
        {list.length === 0 && (
            <div class="px-4 py-12 text-center text-[13px] text-black/40 dark:text-white/40">暂无文章</div>
        )}
        {list.map((p) => {
            const catFull = (p.data.category && p.data.category[0]) || "";
            // 二级分类只显示末级名称，完整路径放在 title 里，避免徽章被撑长
            const cat = catFull ? getCategoryLabel(catFull) : "未分类";
            const kind = POST_KIND_META[getPostKind(p.body, p.data.kind)];

            return (
                <a
                    href={getPostUrlBySlug(p.slug)}
                    class="group flex items-center gap-3 px-4 py-3.5 hover:bg-[var(--btn-regular-bg)] transition-colors"
                >
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2 mb-1">
                            <span class={catBadge} title={catFull || cat}>{cat}</span>
                            <span class="min-w-0 flex-1 truncate font-semibold text-[15px] text-black/85 dark:text-white/85 group-hover:text-[var(--primary)] transition-colors">
                                {p.data.title}
                            </span>
                            {p.data.pinned && (
                                <span class="shrink-0 rounded bg-red-500/10 px-1.5 py-0.5 text-[10.5px] font-bold text-red-500 leading-none">置顶</span>
                            )}
                        </div>
                        {p.data.description && (
                            <p class="line-clamp-1 text-[12.5px] text-black/45 dark:text-white/45">{p.data.description}</p>
                        )}
                        <div class="mt-1 flex items-center gap-2.5 text-[11.5px] text-black/35 dark:text-white/35">
                            <span class={badgeBase} style={`background:${kind.color}`}>{kind.label}</span>
                            <span class="inline-flex min-w-0 items-center gap-1">
                                <Icon name="material-symbols:person-outline-rounded" class="text-[0.9rem]" />
                                {p.data.author || profileConfig.name}
                            </span>
                            <span class="inline-flex items-center gap-1">
                                <Icon name="material-symbols:schedule-outline-rounded" class="text-[0.9rem]" />
                                {formatDateToYYYYMMDD(p.data.published)}
                            </span>
                        </div>
                    </div>
                    <Icon name="material-symbols:chevron-right-rounded" class="shrink-0 text-[1.3rem] text-black/15 dark:text-white/20" />
                </a>
            );
        })}
    </div>

    {totalPages > 1 && <PostPagination currentPage={currentPage} totalPages={totalPages} />}
</div>
