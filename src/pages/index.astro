---
import BoardNav from "@components/resource/BoardNav.astro";
import PostGrid from "@components/resource/PostGrid.astro";
import SiteAside from "@components/resource/SiteAside.astro";
import ThreadList from "@components/resource/ThreadList.astro";
import ResourceLayout from "@layouts/ResourceLayout.astro";
import { siteConfig } from "../config";
import { getHomePosts, getTotalPages, slicePage } from "../utils/home-posts";

/**
 * 首页：资源站三栏版式
 *   左：分类导航 ｜ 中：文章区 ｜ 右：作者卡 / 快捷导航 / 热门标签
 * 三个栏目全部为真实数据（文章集合 + profile.json），不含任何模拟积分/等级/排行。
 * 版式外壳与归档 / 关于 / 友链 / 文章页共用 ResourceLayout。
 *
 * 中栏有两种版式，由「站点设置 → 站点信息 → 首页版式」决定：
 *   grid 封面卡片网格（默认）｜ list 文字列表
 * 两者共用同一份文章序列与分页参数，切换只改外观，不改变任何 URL。
 * 第 2 页起由 src/pages/page/[...page].astro 生成。
 */
const allPosts = await getHomePosts();
const totalPages = getTotalPages(allPosts.length);
const isGrid = siteConfig.homeLayout === "grid";
---

<ResourceLayout
    title={siteConfig.title}
    description={siteConfig.description}
    keywords={siteConfig.keywords}
>
    <BoardNav slot="left" />

    {isGrid ? (
        <PostGrid
            posts={slicePage(allPosts, 1)}
            currentPage={1}
            totalPages={totalPages}
            totalCount={allPosts.length}
        />
    ) : (
        <ThreadList
            posts={slicePage(allPosts, 1)}
            currentPage={1}
            totalPages={totalPages}
            totalCount={allPosts.length}
        />
    )}

    <SiteAside slot="right" />
</ResourceLayout>
