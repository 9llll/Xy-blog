---
import { Icon } from "astro-icon/components";
import BoardNav from "@components/resource/BoardNav.astro";
import SiteAside from "@components/resource/SiteAside.astro";
import ResourceLayout from "@layouts/ResourceLayout.astro";

/**
 * 404 页面
 *
 * 这个文件的存在本身就是修复：此前仓库里没有 404.astro，
 * 构建产物没有 dist/404.html，托管方只能回退到首页并返回 200，
 * 结果是任意不存在的网址都返回「200 + 首页内容」，
 * 搜索引擎会把大量垃圾 URL 当成有效页收录（软 404）。
 * 有了 dist/404.html 后，不存在的路径会返回真正的 404 状态码。
 */
---

<ResourceLayout
    title="页面不存在"
    description="你访问的页面不存在或已被移除，可以返回首页或使用站内搜索查找资源。"
>
    <BoardNav slot="left" />

    <div class="overflow-hidden rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] shadow-sm">
        <div class="flex flex-col items-center px-6 py-14 text-center md:py-20">
            <div class="text-[64px] font-black leading-none tracking-tight text-[var(--primary)] opacity-90 md:text-[80px]">
                404
            </div>

            <h1 class="mt-3 text-[17px] font-bold text-black/85 dark:text-white/85">
                这个页面不存在
            </h1>
            <p class="mt-2 max-w-[26rem] text-[13.5px] leading-relaxed text-black/50 dark:text-white/50">
                链接可能已经失效、资源被下架，或者网址输错了。
                可以回首页看看最新发布，也可以直接搜索想要的内容。
            </p>

            <div class="mt-6 flex flex-wrap items-center justify-center gap-2.5">
                <a
                    href="/"
                    class="no-styling inline-flex items-center gap-1.5 rounded-full bg-[var(--primary)] px-5 py-2.5 text-[13.5px] font-bold text-white shadow-sm transition-all hover:brightness-110 active:scale-[0.97]"
                >
                    <Icon name="material-symbols:home-rounded" class="text-[1.1rem]" />
                    返回首页
                </a>
                <a
                    href="/search/"
                    class="no-styling inline-flex items-center gap-1.5 rounded-full border border-[var(--line-divider)] px-5 py-2.5 text-[13.5px] font-bold text-black/75 transition-colors hover:bg-[var(--btn-plain-bg-hover)] dark:text-white/75"
                >
                    <Icon name="material-symbols:search-rounded" class="text-[1.1rem]" />
                    站内搜索
                </a>
            </div>
        </div>
    </div>

    <SiteAside slot="right" />
</ResourceLayout>
