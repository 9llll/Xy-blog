---
import type { GetStaticPaths } from "astro";
import BoardNav from "../../components/resource/BoardNav.astro";
import SiteAside from "../../components/resource/SiteAside.astro";
import ThreadList from "../../components/resource/ThreadList.astro";
import ResourceLayout from "../../layouts/ResourceLayout.astro";
import { siteConfig } from "../../config";
import { getHomePosts, getTotalPages, slicePage } from "../../utils/home-posts";
import type { PostForList } from "../../utils/content-utils";

interface Props {
	pageNum: number;
	totalPages: number;
	totalCount: number;
	posts: PostForList[];
}

/**
 * 首页分页：/page/2/、/page/3/ …
 *
 * 首页只放 10 篇，第 2 页起由本路由生成。第 1 页就是 /，
 * /page/1/ 走 301 跳转，避免同一批文章出现两个可收录地址。
 */
export const getStaticPaths = (async () => {
	const posts = await getHomePosts();
	const totalPages = getTotalPages(posts.length);

	return Array.from({ length: Math.max(0, totalPages - 1) }, (_, i) => {
		const pageNum = i + 2;
		return {
			params: { page: String(pageNum) },
			props: {
				pageNum,
				totalPages,
				totalCount: posts.length,
				posts: slicePage(posts, pageNum),
			} satisfies Props,
		};
	});
}) satisfies GetStaticPaths;

const { pageNum, totalPages, totalCount, posts } = Astro.props as Props;
---

<ResourceLayout
    title={`最新发布 · 第 ${pageNum} 页`}
    description={`${siteConfig.description}（第 ${pageNum} 页）`}
    keywords={siteConfig.keywords}
>
    <BoardNav slot="left" />

    <ThreadList
        posts={posts}
        currentPage={pageNum}
        totalPages={totalPages}
        totalCount={totalCount}
    />

    <SiteAside slot="right" />
</ResourceLayout>
