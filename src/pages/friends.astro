---
import BoardNav from "@components/resource/BoardNav.astro";
import SiteAside from "@components/resource/SiteAside.astro";
import ResourceLayout from "@layouts/ResourceLayout.astro";
import { Icon } from "astro-icon/components";
import ImageWrapper from "../components/misc/ImageWrapper.astro";
import { friends } from "@/config";
---

<ResourceLayout title="友情链接">
    <BoardNav slot="left" />

    <div class="rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] p-5 shadow-sm md:p-7">
        <div class="mb-5 flex items-center gap-2">
            <div class="flex h-8 w-8 items-center justify-center rounded-lg bg-[var(--primary)] text-white">
                <Icon name="material-symbols:diversity-3" class="text-[1.5rem]" />
            </div>
            <h1 class="text-2xl font-bold text-black dark:text-white">友情链接</h1>
        </div>
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            {friends.map((item) => (
                <div class="friend-card">
                    <a href={item.url} target="_blank" class="flex w-full gap-2">
                        <div class="h-[60px] w-[60px] overflow-hidden rounded bg-[#fff]">
                            <ImageWrapper src={item.avatar} class="h-full w-full" />
                        </div>
                        <div class="max-w-[calc(100%-5rem)]">
                            <div class="font-bold text-black dark:text-white">{item.name}</div>
                            <div class="line-clamp-2 text-sm text-black/50 dark:text-white/50">{item.description}</div>
                        </div>
                    </a>
                </div>
            ))}
        </div>
    </div>

    <SiteAside slot="right" />
</ResourceLayout>

<style>
.friend-card {
    @apply flex flex-initial gap-1 p-4 rounded-lg bg-[var(--btn-regular-bg)] hover:bg-[var(--btn-regular-bg-hover)] transition;
}
</style>
