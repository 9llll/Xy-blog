---
import ArchivePanel from "@components/ArchivePanel.svelte";
import BoardNav from "@components/resource/BoardNav.astro";
import SiteAside from "@components/resource/SiteAside.astro";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import ResourceLayout from "@layouts/ResourceLayout.astro";
import { getSortedPostsList } from "../utils/content-utils";

const sortedPostsList = await getSortedPostsList();

/**
 * ArchivePanel 是 client:load 的 Svelte 岛，props 会被完整序列化进 HTML。
 * 直接传 collection entry 会把 frontmatter 里的 downloadLinks（含访问密码 / 提取码）
 * 和 Astro 内部 rendered.html 一起写进页面源码。这里只投影归档列表真正用到的字段。
 */
const archivePosts = sortedPostsList.map((p) => ({
	slug: p.slug,
	data: {
		title: p.data.title,
		tags: p.data.tags ?? [],
		category: p.data.category,
		published: p.data.published,
	},
}));

/**
 * 筛选条件在服务端解析后作为 props 传入，组件内不再读 window。
 * 这样归档页可以用 client:load：首屏 HTML 自带完整列表（对爬虫可见），
 * 之前用 client:only 时源码里一个字都没有。
 */
const searchParams = Astro.url.searchParams;
const filterTags = searchParams.getAll("tag");
const filterCategories = searchParams.getAll("category");
const onlyUncategorized = searchParams.has("uncategorized");
---

<ResourceLayout title={i18n(I18nKey.archive)}>
    <BoardNav slot="left" />

    <div class="overflow-hidden rounded-xl border border-[var(--line-divider)] bg-[var(--card-bg)] shadow-sm">
        <ArchivePanel
            sortedPosts={archivePosts}
            filterTags={filterTags}
            filterCategories={filterCategories}
            onlyUncategorized={onlyUncategorized}
            client:load
        ></ArchivePanel>
    </div>

    <SiteAside slot="right" />
</ResourceLayout>
